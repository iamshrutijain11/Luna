{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatResponse",
  "type": "object",
  "required": ["conversation_id", "message", "citations", "suggested_actions"],
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "document_title", "page", "text_snippet"],
        "properties": {
          "document_id": { "type": "string" },
          "document_title": { "type": "string" },
          "page": { "type": "integer" },
          "text_snippet": { "type": "string" }
        }
      }
    },
    "workflow_id": {
      "type": ["string", "null"]
    },
    "suggested_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
