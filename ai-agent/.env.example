# ==============================================================================
# LUMA AI AGENT CONFIGURATION
# ==============================================================================

# LLM Provider Selection: gemini (Primary/Default), groq, ollama, bedrock
LLM_PROVIDER=gemini

# Primary Provider: Google Gemini API (Free Tier Compatible)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Provider: Groq Cloud API (Free Tier Compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Provider: Ollama (Local Inference, Zero-Cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Provider: Amazon Bedrock (Retained, requires AWS credentials)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Execution Limits & Rate-Limit Safeguards
MAX_AGENT_TOOL_CALLS=8
LLM_TIMEOUT_SECONDS=45

# MCP Protocol Configuration
MCP_PORT=8001
MCP_TRANSPORT=streamable_http
